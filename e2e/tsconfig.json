{
  "compilerOptions": {
    "lib": ["es2024", "esnext.array", "esnext.collection", "esnext.error", "es2025.iterator", "es2025.promise"],
    "module": "nodenext",
    "target": "es2024",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node16",
    "moduleDetection": "force"
  },
  "include": ["./**/*"]
}
